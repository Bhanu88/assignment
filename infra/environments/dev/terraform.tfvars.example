# Example terraform.tfvars file
# Copy this to terraform.tfvars and customize values

resource_group_name  = "rg-aks-assignment"
location             = "East US"
aks_cluster_name     = "aks-cluster"
storage_account_name = "staksprivate" # Must be globally unique, 3-24 lowercase alphanumeric characters
kubernetes_version   = "1.28.3"
node_count           = 2
vm_size              = "Standard_D2s_v3"
min_count            = 2
max_count            = 5

tags = {
  Environment = "Development"
  ManagedBy   = "Terraform"
  Project     = "AKS-Assignment"
}

# Cost Optimization Settings
cost_center                      = "engineering"  # For cost tracking and chargeback
scale_down_utilization_threshold = 0.5            # 0.5 = scale down nodes below 50% utilization (aggressive for dev/test)
